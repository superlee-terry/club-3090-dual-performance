# =============================================================================
# Qwen3.6-27B DFlash dual-3090 deployment configuration
# Copy to .env and adjust values:  cp .env.example .env
# =============================================================================

# --- Model storage ---
# Where model weights are stored (relative to docker/ root).
# Files expected:
#   <MODEL_DIR>/qwen3.6-27b/autoround-int4/   (main model, ~14 GB)
#   <MODEL_DIR>/qwen3.6-27b/dflash/            (DFlash draft, ~3.5 GB)
MODEL_DIR=./models

# --- API endpoint ---
PORT=11434
BIND_HOST=0.0.0.0

# --- GPU selection ---
# Comma-separated GPU IDs. Default: all GPUs.
# Examples: "0,1" for first two GPUs, "all" for everything.
GPUS=all

# --- HuggingFace ---
# Required if model repo is gated. Usually not needed for public models.
HF_TOKEN=

# --- Parallelism ---
TP=2
PP=1

# --- Context & memory ---
MAX_MODEL_LEN=185000
GPU_MEMORY_UTILIZATION=0.95

# --- Container ---
CONTAINER_NAME=vllm-qwen36-27b-dflash

# --- Model alias ---
# Name exposed via the API. Change to whatever you like.
MODEL_ALIAS=qwen3.6

# --- vLLM image ---
# Pinned nightly with DFlash support.
# Override only if you know what you're doing.
VLLM_IMAGE=lee21321/vllm-openai:club-3090-performance

# --- Sampling defaults ---
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
REPEAT_PENALTY=1.0
# Enable thinking/reasoning mode (true/false)
ENABLE_THINKING=false

# --- NVLink ---
# auto: detect automatically (recommended)
# force_on: enable NVLink even if not detected
# force_off: disable NVLink even if present
NVLINK_MODE=auto

# --- Troubleshooting ---
# Uncomment to disable CUDA graphs (WSL2 or stability issues):
# VLLM_ENFORCE_EAGER=1
# Uncomment if running on WSL2 or if boot crashes with expandable_segments:
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False,max_split_size_mb:512

# =============================================================================
# MoE llama.cpp (Qwen3.6-35B-A3B)
# =============================================================================

MOE_CTX=196608
MOE_KV_TYPE=q8_0
MOE_BATCH=2048
MOE_UBATCH=512
MOE_CONTAINER=ik-llama-moe
MOE_IMAGE=ghcr.io/ikawrakow/ik-llama-cpp:cu13-server

# =============================================================================
# MoE vLLM AWQ + MTP-3 (Qwen3.6-35B-A3B)
# =============================================================================

MOE_AWQ_CTX=200000
MOE_AWQ_GPU_UTIL=0.95
MOE_AWQ_CONTAINER=vllm-qwen36-35b-a3b-mtp
MOE_AWQ_IMAGE=lee21321/vllm-openai:club-3090-performance
MOE_AWQ_MODEL_ALIAS=qwen3.6
MOE_AWQ_MTP_TOKENS=3

# =============================================================================
# DFlash + INT8 PTH KV (Qwen3.6-27B long-context)
# =============================================================================

DFLASH_INT8_CONTAINER=vllm-qwen36-27b-dflash-int8
DFLASH_INT8_MAX_MODEL_LEN=262144
DFLASH_INT8_GPU_UTIL=0.95
DFLASH_INT8_KV_DTYPE=int8_per_token_head

# =============================================================================
# 27B Dense FP8 KV + MTP-3 (Qwen3.6-27B general-purpose)
# =============================================================================

FP8_MTP_CONTAINER=vllm-qwen36-27b-fp8-mtp
FP8_MTP_MAX_MODEL_LEN=262144
FP8_MTP_GPU_UTIL=0.92
FP8_MTP_KV_DTYPE=fp8_e5m2
FP8_MTP_MTP_TOKENS=3
FP8_MTP_IMAGE=vllm/vllm-openai:v0.21.0

# =============================================================================
# Gemma 4 26B-A4B MoE AWQ + MTP-4
# =============================================================================

GEMMA4_MTP_CTX=32768
GEMMA4_MTP_GPU_UTIL=0.92
GEMMA4_MTP_CONTAINER=vllm-gemma4-26b-a4b-mtp
GEMMA4_MTP_IMAGE=lee21321/vllm-openai:club-3090-performance
GEMMA4_MTP_MODEL_ALIAS=gemma4
GEMMA4_MTP_MTP_TOKENS=4
